{
  "name": "semantic-diff",
  "version": "0.1.0",
  "description": "Semantic diffs for TypeScript and Python: renames, moves, extracts, inlines, and AST-level logic edits.",
  "type": "module",
  "bin": {
    "semantic-diff": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "viewer",
    "schema",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "viewer:samples": "tsx scripts/generate-samples.ts",
    "example": "tsx src/cli.ts fixtures/typescript/mixed/before fixtures/typescript/mixed/after"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Ata Perata <99473563+ataperata@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ataperata/semantic-diff.git"
  },
  "bugs": {
    "url": "https://github.com/ataperata/semantic-diff/issues"
  },
  "homepage": "https://github.com/ataperata/semantic-diff#readme",
  "dependencies": {
    "tree-sitter": "^0.21.1",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
